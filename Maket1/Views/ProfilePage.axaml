<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Maket1.Views.ProfilePage">

    <StackPanel Spacing="14">

        <TextBlock Text="Личный кабинет" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"/>

        <Border Classes="card" MaxWidth="500" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="16">

                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{DynamicResource PrimaryBrush}">
                    <TextBlock x:Name="InitialText" FontSize="26" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="NameText" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="LoginText" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="Должность: Разработчик" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>