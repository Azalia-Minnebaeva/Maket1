<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Maket1.Views.OverviewPage">

    <ScrollViewer>
        <StackPanel Spacing="14">

            <TextBlock Text="Обзор" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>

            <!-- 4 карточки -->
            <Grid ColumnDefinitions="*,*,*,*">

                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Проекты" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="12" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Активных проектов" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Задачи" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="48" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="В работе" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="card" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Команда" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="8" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Участников" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Classes="card">
                    <StackPanel>
                        <TextBlock Text="Сроки" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="5" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Просрочено" FontSize="11" Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Border>

            </Grid>

            <Grid ColumnDefinitions="*,250">

                <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,14,0">

                    <!-- Активные проекты -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Активные проекты" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <Grid ColumnDefinitions="*,150">
                                <TextBlock Grid.Column="0" Text="Avalonia UI Redesign" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <Border Background="#206C4DE6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Дизайн" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                    <ProgressBar Value="65" Maximum="100" Height="5" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="65%" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,150">
                                <TextBlock Grid.Column="0" Text="Мобильное приложение" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <Border Background="#203B82F6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Разработка" FontSize="11" Foreground="#3B82F6"/>
                                    </Border>
                                    <ProgressBar Value="40" Maximum="100" Height="5" Foreground="#3B82F6"/>
                                    <TextBlock Text="40%" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,150">
                                <TextBlock Grid.Column="0" Text="Корпоративный сайт" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <Border Background="#203B82F6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Разработка" FontSize="11" Foreground="#3B82F6"/>
                                    </Border>
                                    <ProgressBar Value="80" Maximum="100" Height="5" Foreground="#2FB36D"/>
                                    <TextBlock Text="80%" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Последние задачи -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Последние задачи" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <Grid ColumnDefinitions="*,90,80">
                                <CheckBox Grid.Column="0" Content="Разработать макет главной страницы"/>
                                <Border Grid.Column="1" Background="#206C4DE6" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Дизайн" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="15.05.2024" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,90,80">
                                <CheckBox Grid.Column="0" Content="Реализовать авторизацию"/>
                                <Border Grid.Column="1" Background="#203B82F6" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Разработка" FontSize="11" Foreground="#3B82F6"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="14.05.2024" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,90,80">
                                <CheckBox Grid.Column="0" Content="Подготовить презентацию"/>
                                <Border Grid.Column="1" Background="#202FB36D" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Маркетинг" FontSize="11" Foreground="#2FB36D"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="13.05.2024" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Мини-календарь -->
                <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Календарь" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Май 2024" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        <UniformGrid x:Name="CalendarGrid" Columns="7"/>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>